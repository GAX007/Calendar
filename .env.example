# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# SUPABASE: Claves de base de datos en la nube (PostgreSQL)
# Obtenlas en https://supabase.com -> Tu Proyecto -> Project Settings -> API
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-clave-anon-publica"

# SUPABASE SERVICE ROLE KEY:
# Clave privada para las funciones del backend (Netlify Functions).
# Permite escribir y sincronizar en Supabase saltando RLS de forma segura.
# NUNCA usar en el frontend ni poner prefijo VITE_. Configurar en Netlify Environment Variables.
SUPABASE_SERVICE_ROLE_KEY="tu-clave-service-role-privada"

# MOODLE_ICS_URL: URL privada del calendario de Moodle (formato ICS con token).
# Configurar en Netlify Environment Variables y en .env.local para desarrollo local.
# NUNCA exponer en frontend, logs ni repositorio.
#
# IMPORTANTE sobre el rango: En Moodle, ve a Calendario -> Exportar calendario y genera la URL
# seleccionando un intervalo personalizado (preset_time=custom) para cubrir todo el curso o cuatrimestre,
# ya que la opción por defecto 'recentupcoming' solo cubre unos 60 días.
MOODLE_ICS_URL="https://moodle.ejemplo.edu/calendar/export_execute.php?userid=00000&authtoken=TOKEN_PRIVADO&preset_what=all&preset_time=custom"
